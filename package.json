{
  "name": "playwright-automation",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "regression": "playwright test --grep @regression",
    "smoke": "playwright test --grep @smoke",
    "firefox": "playwright test --project=firefox --config=playwright.config1.js",
    "cucumber": "cucumber-js",
    "cucumberWTags": "npx cucumber-js --tags '@errorValidationsMultiple' --exit",
    "cucumberReport": "npx cucumber-js features  --exit --format html:cucumber-report.html",
    "cucumberRetry": "npx cucumber-js --retry 2 --exit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "allure-playwright": "^3.14.0",
    "exceljs": "^3.4.0"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  }
}
